{
  "version": 1,
  "author": "Antigravity ESP32 Reliable Data Logger",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -130, "left": 140, "attrs": {} },
    { "type": "wokwi-led", "id": "led_pin2", "top": 120, "left": -110, "attrs": { "color": "green", "label": "Pin 2 (Boot v1)" } },
    { "type": "wokwi-led", "id": "led_pin3", "top": 180, "left": -110, "attrs": { "color": "yellow", "label": "Pin 15 (OTA v2)" } },
    { "type": "wokwi-led", "id": "led_pin4", "top": 240, "left": -110, "attrs": { "color": "blue", "label": "Pin 4 (OTA v3)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": -35, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 190, "left": -35, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 250, "left": -35, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 100, "left": 200, "attrs": { "color": "blue" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:5", "green", [] ],
    [ "esp:2", "r1:1", "green", [] ],
    [ "r1:2", "led_pin2:A", "green", [] ],
    [ "led_pin2:C", "esp:GND.1", "black", [] ],
    [ "esp:15", "r2:1", "yellow", [] ],
    [ "r2:2", "led_pin3:A", "yellow", [] ],
    [ "led_pin3:C", "esp:GND.1", "black", [] ],
    [ "esp:4", "r3:1", "blue", [] ],
    [ "r3:2", "led_pin4:A", "blue", [] ],
    [ "led_pin4:C", "esp:GND.1", "black", [] ],
    [ "btn1:1.l", "esp:13", "blue", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
